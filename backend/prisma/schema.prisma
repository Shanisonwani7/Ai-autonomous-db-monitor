generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  role      String     @default("user")
  createdAt DateTime   @default(now())

  databases Database[]
}

model Database {
  id        Int      @id @default(autoincrement())
  name      String
  dbType    String
  host      String
  port      Int
  username  String
  password  String

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}